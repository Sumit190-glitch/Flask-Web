    }

    try {
        var params = {
            source: getParameter('utm_source'),
            medium: getParameter('utm_medium'),
            campaign: getParameter('utm_campaign'),
            ref: getParameter('ref'),

            host: document.location.host,
            path: document.location.pathname,
            referrer: document.referrer
        };

