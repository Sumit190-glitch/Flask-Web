            function trackMarketingFormSubmission(eventName, traits, properties) {
                if (!window.analytics) {
                    return;
                }

                traits = compactProperties(traits || {});
                properties = compactProperties(properties || {});

                if (Object.keys(traits).length && typeof window.analytics.identify === "function") {
                    window.analytics.identify(traits);
                }

                if (typeof window.analytics.track === "function") {
                    window.analytics.track(eventName, properties);
                }
            }

            document.addEventListener("submit", function(event) {
                var form = event.target;
                if (!form || typeof form.matches !== "function") {
                    return;
                }

                if (form.matches("#wf-sales-form")) {
