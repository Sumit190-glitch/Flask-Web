hosted-api' target='_blank' rel='noreferrer'>hosted inference endpoint</a> counts as one Inference, no matter how many classes (if any) were detected. Workflows on the Hosted Inference API will be billed per model where an inference is run (there are often multiple inference per Workflow).</span>",unitMeasurementName:"inference"},batchVideoInference:{id:"batchVideoInference",name:l.UBP_FEATURE_GROUP_NAMES.batchVideoInference,icon:"far fa-cloud",type:p.deployment.id,deprecated:!0,description:"(Legacy) Hosted inference v1 endpoint. Videos submitted to the Hosted Video Inference API. Credits are consumed per minute of video FPS.",conversionRateTransform:e=>e/60,unitMeasurementName:"minute"},batchProcessingCPU:{id:"batchProcessingCPU",name:l.UBP_FEATURE_GROUP_NAMES.batchProcessingCPU,icon:"far fa-list-check",type:p.deployment.id,description:"Length of time Batch Processing CPU machines are running.",conversionRateTransform:e=>60*e*60,unitMeasurementName:"hour"},batchProcessingGPU:{id:"batchProcessingGPU",name:l.UBP_FEATURE_GROUP_NAMES.batchProcessingGPU,icon:"far fa-list-check",type:p.deployment.id,description:"Length of time Batch Processing GPU machines are running.",conversionRateTransform:e=>60*e*60,unitMeasurementName:"hour"},dedicatedDeploymentCPU:{id:"dedicatedDeploymentCPU",name:l.UBP_FEATURE_GROUP_NAMES.dedicatedDeploymentCPU,icon:"far fa-server",type:p.deployment.id,description:"Length of time CPUs are running.",unitMeasurementName:"hour"},dedicatedDeploymentGPU:{id:"dedicatedDeploymentGPU",name:l.UBP_FEATURE_GROUP_NAMES.dedicatedDeploymentGPU,icon:"far fa-server",type:p.deployment.id,description:"Length of time GPUs are running.",unitMeasurementName:"hour"},selfHostedInferenceRun:{id:"selfHostedInferenceRun",name:l.UBP_FEATURE_GROUP_NAMES.selfHostedInferenceRun,icon:"far fa-microchip",type:p.deployment.id,description:"Number of images inferred on using the <a href='https://inference.roboflow.com/quickstart/roboflow_ecosystem/' target='_blank' rel='noreferrer'>Self Hosted Inference SDKs.</a> (1 credit covers 3,000 inferences – equivalent of 48 hours of live video running at 1 frame per minute)",unitMeasurementName:"inference"},selfHostedStream:{id:"selfHostedStream",name:l.UBP_FEATURE_GROUP_NAMES.selfHostedStream,icon:"far fa-microchip",type:p.deployment.id,description:"Number of minutes of video stream processed using the <a href='https://inference.roboflow.com/quickstart/roboflow_ecosystem/' target='_blank' rel='noreferrer'>Self Hosted Inference SDKs, regardless of FPS. Counts as the quantity of video footage provided from a single camera. If a single camera processes more than 10,000 minutes of footage in a month, credit usage for that camera will be capped at 20.</a>",conversionRateTransform:e=>60*e,unitMeasurementName:"minute"},thirdPartyApi:{id:"thirdPartyApi",name:l.UBP_FEATURE_GROUP_NAMES.thirdPartyApi,icon:"far fa-plug",type:p.deployment.id,description:"Workflow blocks that make 3rd party API requests without your own API Key",unitDisplayString:"<a href='https://roboflow.com/credits' target='_blank' rel='noreferrer'>credits vary by vendor</a>"},serverlessStreamingCpu:{id:"serverlessStreamingCpu",name:l.UBP_FEATURE_GROUP_NAMES.serverlessStreamingCpu,icon:"far fa-video",type:p.deployment.id,description:"Real-time video streaming for workflows using CPU. Credits are consumed per second of execution time.",unitMeasurementName:"hour",conversionRateTransform:e=>3600*e,unitDisplayString:"0.1 credits / hour"},serverlessStreamingGpuSmall:{id:"serverlessStreamingGpuSmall",name:l.UBP_FEATURE_GROUP_NAMES.serverlessStreamingGpuSmall,icon:"far fa-video",type:p.deployment.id,description:"Real-time video streaming for workflows using GPU Small. Credits are consumed per second of execution time.",unitMeasurementName:"hour",conversionRateTransform:e=>3600*e,unitDisplayString:"0.75 credits / hour"},serverlessStreamingGpuMedium:{id:"serverlessStreamingGpuMedium",name:l.UBP_FEATURE_GROUP_NAMES.serverlessStreamingGpuMedium,icon:"far 