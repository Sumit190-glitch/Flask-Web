.CreditSystem]:{id:i.CreditSystem,name:"Credit System",description:"Use the credit-based UBP billing system for usage and quotas.",section:"billingSubscription",controlType:"checkbox",order:10,overwriteOnPlanChange:!0,category:"behavior"},[i.AdvancedApiKeys]:{id:i.AdvancedApiKeys,name:"Advanced API Key Management",description:"Advanced API key management including scoped permissions, multiple keys, and key disabling.",section:"workspaceAdminAccessControl",controlType:"checkbox",order:10,overwriteOnPlanChange:!0,category:"product"},[i.AllowPrivateProjects]:{id:i.AllowPrivateProjects,name:"Allow Private Projects",feature:o.Feature.PrivateProjects,section:"workspaceAdminAccessControl",controlType:"checkbox",order:20,overwriteOnPlanChange:!0,category:"product"},[i.AllowMultipleTrials]:{id:i.AllowMultipleTrials,name:"Allow Multiple Trials",description:"Allows any user in this workspace to activate a Premium Trial even if they have previously used one. Useful for Roboflow internal testing and demos.",section:"billingSubscription",controlType:"checkbox",order:30,overwriteOnPlanChange:!0,category:"behavior"},[i.ApiUpload]:{id:i.ApiUpload,name:"API Upload",section:"dataUploadIngestion",controlType:"checkbox",order:40,overwriteOnPlanChange:!0,category:"product"},[i.EmailUpload]:{id:i.EmailUpload,name:"Email Upload",section:"dataUploadIngestion",controlType:"checkbox",order:50,overwriteOnPlanChange:!0,category:"product"},[i.VideoProcessing]:{id:i.VideoProcessing,name:"Video Processing",section:"dataUploadIngestion",controlType:"checkbox",order:60,overwriteOnPlanChange:!0,category:"product"},[i.VideoSources]:{id:i.VideoSources,name:"Video Sources",description:"Video sources preview: register cameras/streams via the video connector and run workflows on them with live annotated output. Dark by default; not part of any plan.",section:"dataUploadIngestion",controlType:"checkbox",order:61,overwriteOnPlanChange:!1,category:"product"},[i.HealthCheck]:{id:i.HealthCheck,name:"Dataset Analytics",description:"Enable Dataset Analytics (Health Check) for projects.",section:"datasetVersionManagement",controlType:"checkbox",order:70,overwriteOnPlanChange:!0,category:"product"},[i.AdvancedTransforms]:{id:i.AdvancedTransforms,name:"Advanced Transforms",description:"Unlock advanced augmentation transforms (motion blur, camera gain, cutout, hue, saturation, etc.) and preprocessing options (contrast types, static crop, tile, isolate, remap, filter-tags).",section:"datasetVersionManagement",controlType:"checkbox",order:100,overwriteOnPlanChange:!0,category:"product"},[i.ExportVersion]:{id:i.ExportVersion,name:"Export Version",section:"datasetVersionManagement",controlType:"checkbox",order:110,overwriteOnPlanChange:!0,category:"product"},[i.Rbac]:{id:i.Rbac,name:"RBAC (Labeler Role)",description:"Enable role-based access control with labeler and reviewer roles, custom roles, and fine-grained permission management for workspace members.",section:"workspaceAdminAccessControl",controlType:"checkbox",order:120,overwriteOnPlanChange:!0,category:"product"},[i.AnnotationReview]:{id:i.AnnotationReview,name:"Annotation Review",feature:o.Feature.AnnotationReview,section:"annotationLabeling",controlType:"checkbox",order:130,overwriteOnPlanChange:!0,category:"product"},[i.PolylineAnnotationTool]:{id:i.PolylineAnnotationTool,name:"Polyline Annotation Tool",description:"Allow users to draw open line annotations (polylines) in the annotation editor. Off by default; grant per-workspace for early-access customers until GA. WARNING: polylines are not a supported annotation type for auto labeling or model training.",feature:o.Feature.PolylineAnnotationTool,section:"annotationLabeling",controlType:"checkbox",order:135,overwriteOnPlanChange:!1,category:"product"},[i.WorkspaceInsights]:{id:i.WorkspaceInsights,name:"Workspace Insights",description:"Workspace Insights page showing annotation analytics: images labeled, annotations added/removed/updated, per-labeler breakdowns, etc.",section:"monitoringAnalytics",controlType:"checkbox",order:140,overwriteOnPlanChange:!0,category:"product"},[i.DeviceMonitoring]:{id:i.DeviceMonitoring,name:"Device Monitoring",description:"Enable device monitoring page for managing edge devices, viewing device telemetry, and monitoring deployments.",section:"edgeDevices",controlType:"checkbox",order:150,overwriteOnPlanChange:!0,category:"product"},[i.IndustrialCameras]:{id:i.IndustrialCameras,name:"Industrial Cameras",description:"Allow adding Basler and Lucid industrial camera streams, and PLC Relay / OPC UA server services, in Device Manager V2.",section:"edgeDevices",controlType:"checkbox",order:162,overwriteOnPlanChange:!0,applyPlanChangeOverrideInAdmin:!0,category:"product"},[i.DeviceStatusEvents]:{id:i.DeviceStatusEvents,name:"Device Status Events Beta",description:"Use structured device status events for tracking device, stream, and container lifecycle events (online/offline, started/stopped, errors) with detailed metadata.",section:"edgeDevices",controlType:"checkbox",order:165,overwriteOnPlanChange:!0,category:"behavior"},[i.DeviceAio]:{id:i.DeviceAio,name:"Device All In One",description:"Show the AI1 device type in the Add Device flow (QR / USB onboarding). Staff-granted; not part of any plan.",section:"edgeDevices",controlType:"checkbox",order:167,overwriteOnPlanChange:!1,category:"product"},[i.RoboflowLiteMode]:{id:i.RoboflowLiteMode,name:"Roboflow Lite Mode",description:"Allow AI1 offline-only provisioning (compact QR credentials).",section:"edgeDevices",controlType:"checkbox",order:168,overwriteOnPlanChange:!1,category:"product"},[i.ClassAttributes]:{id:i.ClassAttributes,name:"Class Attributes",description:"Enable class-level attributes to be attached to individual annotations for custom use cases. Models don't train on these.",section:"annotationLabeling",controlType:"checkbox",order:170,overwriteOnPlanChange:!0,applyPlanChangeOverrideInAdmin:!0,category:"product"},[i.AdvancedLabelAssist]:{id:i.AdvancedLabelAssist,name:"Advanced Label Assist",description:"Enable Label Assist (model predictions), Box Prompting (visual prompting), Smart Select/Smart Polygon (segmentation), and Auto Label.",section:"annotationLabeling",controlType:"checkbox",order:180,overwriteOnPlanChange:!0,category:"product"},[i.CloudMlIntegrations]:{id:i.CloudMlIntegrations,name:"Cloud ML Integrations",description:"Allow exports to cloud AutoML integrations (AWS, Google, Azure).",section:"deploymentInference",controlType:"checkbox",order:190,overwriteOnPlanChange:!0,category:"product"},[i.EmbedInMobileApps]:{id:i.EmbedInMobileApps,name:"Embed In Mobile Apps",section:"deploymentInference",controlType:"checkbox",order:200,overwriteOnPlanChange:!0,category:"product"},[i.OfflineMode]:{id:i.OfflineMode,name:"Offline Mode",description:"Allow long-term caching of TensorflowJS (web browser) models for offline use.",section:"deploymentInference",controlType:"checkbox",order:210,overwriteOnPlanChange:!0,category:"product"},[i.VpcDeployment]:{id:i.VpcDeployment,name:"VPC Deployment",section:"deploymentInference",controlType:"checkbox",order:220,overwriteOnPlanChange:!0,category:"product"},[i.HighComplexitySmartPoly]:{id:i.HighComplexitySmartPoly,name:"High Complexity Smart Poly",description:"Enable higher-complexity Smart Polygon settings by lowering the simplification threshold minimum, allowing 'Most Complex' option in the UI slider for more detailed polygon annotations.",section:"annotationLabeling",controlType:"checkbox",order:230,overwriteOnPlanChange:!0,category:"product"},[i.ModelEvaluation]:{id:i.ModelEvaluation,name:"Model Evaluation",feature:o.Feature.ModelEvaluation,section:"trainingModels",controlType:"checkbox",order:240,overwriteOnPlanChange:!0,applyPlanChangeOverrideInAdmin:!0,category:"product"},[i.ActiveLearning]:{id:i.ActiveLearning,name:"Active Learning",section:"activeLearning",controlType:"checkbox",order:250,overwriteOnPlanChange:!0,category:"product"},[i.ActiveLearningDefaultEnabled]:{id:i.ActiveLearningDefaultEnabled,name:"Active Learning Active for All New Projects (API Only)",description:"Automatically add default Active Learning config for API-created datasets.",section:"activeLearning",controlType:"checkbox",order:260,overwriteOnPlanChange:!0,category:"behavior"},[i.ModelMonitoring]:{id:i.ModelMonitoring,name:"Model Monitoring",feature:o.Feature.ModelMonitoring,section:"monitoringAnalytics",controlType:"checkbox",order:280,overwriteOnPlanChange:!0,category:"product"},[i.HipaaCompliance]:{id:i.HipaaCompliance,name:"HIPAA Compliance",description:"Enforce HIPAA compliance restrictions by preventing Roboflow support members (help@roboflow.com) from being added to the workspace. Does not prevent workspace access through adding users in the admin panel.",section:"complianceSecurity",controlType:"checkbox",order:290,overwriteOnPlanChange:!0,category:"product"},[i.DisableSessionRecording]:{id:i.DisableSessionRecording,name:"Disable Session Recording",description:"Prevent session and screen recording for users in this workspace unless a user-level recording override is active.",section:"complianceSecurity",controlType:"checkbox",order:300,overwriteOnPlanChange:!0,applyPlanChangeOverrideInAdmin:!0,category:"behavior"},[i.ManageSourceVideo]:{id:i.ManageSourceVideo,name:"Manage Source Video",description:"Allow managing whole source videos, not just the extracted frames in the dataset.",section:"dataUploadIngestion",controlType:"checkbox",order:310,overwriteOnPlanChange:!0,applyPlanChangeOverrideInAdmin:!0,category:"product"},[i.RefreshAnnotationsButton]:{id:i.RefreshAnnotationsButton,name:"Refresh Annotations Button",description:"Show the Refresh button in Annotation Board.",section:"annotationLabeling",controlType:"checkbox",order:320,overwriteOnPlanChange:!0,category:"behavior"},[i.UnlimitedTimeDedicatedDeployments]:{id:i.UnlimitedTimeDedicatedDeployments,name:"Dedicated Deployments Run Forever",section:"deploymentInference",controlType:"checkbox",